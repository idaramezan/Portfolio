{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "railway:build": "pnpm --filter @workspace/aida-portfolio run build && pnpm --filter @workspace/api-server run build:server",
    "start": "pnpm --filter @workspace/api-server run start",
    "test:sticker-drop": "node scripts/verify-sticker-drop.mjs",
    "test:studio-letter-editorial": "node scripts/verify-studio-letter-editorial.mjs",
    "test:featured-studio-letter": "node scripts/verify-featured-studio-letter.mjs",
    "test:event-banner-admin": "node scripts/verify-event-banner-admin.mjs",
    "test:studio-letter-page": "node scripts/verify-studio-letter-page.mjs",
    "test:shop-preview-order": "node scripts/verify-shop-preview-order.mjs",
    "test:collector-experience": "node scripts/verify-collector-experience.mjs",
    "test:turkiye-catalogue": "node scripts/verify-turkiye-catalogue.mjs",
    "test:design-system": "node scripts/verify-playful-studio-editorial.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "lightningcss-darwin-arm64": "^1.33.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
